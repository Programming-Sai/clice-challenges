#!/bin/bash
# reboot stand-in: simulates a reboot of the training "server".
if [ "$(id -u)" != 0 ]; then
  echo "Failed to set wall message, ignoring: Interactive authentication required." >&2
  echo "Call to Reboot failed: Interactive authentication required." >&2
  exit 1
fi
exec /usr/local/lib/kente/boot-sim
